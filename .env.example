# Database
POSTGRES_DB=gearheads
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Spring datasource
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/gearheads
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
SPRING_JPA_HIBERNATE_DDL_AUTO=validate

# Keycloak (OAuth2 JWT resource server)
KEYCLOAK_SERVER_URL=http://localhost:8180
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/ragro
KEYCLOAK_JWK_SET_URI=http://localhost:8180/realms/ragro/protocol/openid-connect/certs
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# MinIO object storage (client-facing URL; use 10.0.2.2 on the Android emulator)
MINIO_PUBLIC_URL=http://localhost:9000

# Ollama (dev-local only; Docker forces http://ollama:11434)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma2:2b
OLLAMA_CONNECT_TIMEOUT_MS=2000
OLLAMA_READ_TIMEOUT_MS=30000

# Google Maps server-side key (geocoding + routes)
GOOGLE_MAPS_API_KEY=
