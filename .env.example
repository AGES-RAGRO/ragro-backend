# Database Configuration
POSTGRES_DB=gearheads
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Spring Boot - Database
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/gearheads
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# Spring Boot - JPA/Hibernate
SPRING_JPA_HIBERNATE_DDL_AUTO=validate

# ============================================================================
# Keycloak - OAuth2 JWT Resource Server
# ============================================================================

# Keycloak server URL (without trailing slash)
KEYCLOAK_SERVER_URL=http://localhost:8180

# JWT Issuer URI - used by Spring Security to validate tokens
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/ragro

# JWK Set URI - used by Spring Security to fetch public keys
KEYCLOAK_JWK_SET_URI=http://localhost:8180/realms/ragro/protocol/openid-connect/certs

# Keycloak Admin credentials (used for user registration via Admin REST API)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# ============================================================================
# MinIO - Object storage for producer photos
# ============================================================================
# Public URL visible to the client.
# - Android emulator:        http://10.0.2.2:9000
# - iOS simulator / desktop: http://localhost:9000
# - Physical device:         http://<host-lan-ip>:9000
MINIO_PUBLIC_URL=http://localhost:9000

# ============================================================================
# Ollama - LLM local para re-ranking de recomendações
# ============================================================================
# URL base da API do Ollama (interno: ollama:11434 em Docker, localhost:11434 em dev local)
OLLAMA_BASE_URL=http://localhost:11434

# Modelo Gemma 2B (Google) - leve, adequado para containers com ~1GB RAM
# Para puxar: ollama pull gemma2:2b
OLLAMA_MODEL=gemma2:2b

# Timeout HTTP em ms para chamadas ao Ollama
OLLAMA_TIMEOUT_MS=3000
