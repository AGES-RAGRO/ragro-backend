POSTGRES_DB=gearheads
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/gearheads
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_JWK_SET_URI=http://localhost:9999/mock-jwks
# Credenciais sem default no application.yml (fail-fast em prod, E0): valores fake só para o
# container do docker-build-scan subir. Sem Keycloak/MinIO reais no compose.test — esses clients
# são lazy/tolerantes a falha; só precisam dos placeholders resolvidos no boot.
KEYCLOAK_ADMIN_PASSWORD=test-admin
STORAGE_ACCESS_KEY=test-access
STORAGE_SECRET_KEY=test-secret
# Spring AI (client OpenAI → NVIDIA) faz fail-fast no boot se a api-key vier vazia; dummy só para
# o ChatModel ser construído (nunca é chamado no docker-build-scan).
NVIDIA_API_KEY=test-key
